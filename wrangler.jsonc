// Chỉ dùng khi dự án Cloudflare là "Worker". Dự án "Pages" bỏ qua file này
// (Pages cần đặt Build output directory = site trong phần cài đặt).
{
  "name": "vi-tri-studio",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "keep_vars": true,
  // Nhắc gọi lại khách mỗi 30 phút; báo cáo tuần 8h sáng thứ Hai giờ Việt Nam (1h UTC)
  // Trạm chuyển tiếp gọi AI đặt cố định ở Mỹ (lib/ai-relay.js): tránh Anthropic/Gemini chặn trạm Hồng Kông
  "durable_objects": { "bindings": [{ "name": "AI_RELAY", "class_name": "AiRelay" }, { "name": "VBEE_BOX", "class_name": "VbeeBox" }] },
  "migrations": [{ "tag": "v1-ai-relay", "new_sqlite_classes": ["AiRelay"] }, { "tag": "v2-vbee-box", "new_sqlite_classes": ["VbeeBox"] }],
  "triggers": { "crons": ["*/30 * * * *", "0 1 * * 1"] },
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/demo.mp4", "/huong-dan.mp4", "/can/*", "/m/*", "/goi/*", "/", "/index.html", "/gioi-thieu*", "/admin*", "/dieu-khoan*", "/chinh-sach-bao-mat*"]
  }
}
