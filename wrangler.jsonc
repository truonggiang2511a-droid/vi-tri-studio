// Chỉ dùng khi dự án Cloudflare là "Worker". Dự án "Pages" bỏ qua file này
// (Pages cần đặt Build output directory = site trong phần cài đặt).
{
  "name": "vi-tri-studio",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "keep_vars": true,
  // Workers AI (19/11): Whisper nghe lại giọng đọc để khớp thời điểm từng chữ (/api/align, lib/align.js)
  "ai": { "binding": "AI" },
  // 28/11: kho nhớ kết quả bản đồ dùng chung mọi trạm Cloudflare (lib/map.js cached)
  "r2_buckets": [{ "binding": "MAP_STORE", "bucket_name": "vitristudio-map-cache" }],
  // 28/11: chặn 1 IP gọi /api/map dồn dập (số lần mỗi 60 giây, tính theo từng trạm Cloudflare)
  "ratelimits": [
    { "name": "MAP_LIMIT", "namespace_id": "2811", "simple": { "limit": 300, "period": 60 } },
    { "name": "MAP_PAID_LIMIT", "namespace_id": "2812", "simple": { "limit": 40, "period": 60 } }
  ],
  // Nhắc gọi lại khách mỗi 30 phút; báo cáo tuần 8h sáng thứ Hai giờ Việt Nam (1h UTC)
  // Trạm chuyển tiếp gọi AI đặt cố định ở Mỹ (lib/ai-relay.js): tránh Anthropic/Gemini chặn trạm Hồng Kông
  "durable_objects": { "bindings": [{ "name": "AI_RELAY", "class_name": "AiRelay" }, { "name": "VBEE_BOX", "class_name": "VbeeBox" }] },
  "migrations": [{ "tag": "v1-ai-relay", "new_sqlite_classes": ["AiRelay"] }, { "tag": "v2-vbee-box", "new_sqlite_classes": ["VbeeBox"] }],
  "triggers": { "crons": ["*/30 * * * *", "0 1 * * 1", "0 0 * * *"] },
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/oauth/*", "/.well-known/*", "/demo.mp4", "/huong-dan.mp4", "/can/*", "/m/*", "/goi/*", "/", "/index.html", "/gioi-thieu*", "/admin*", "/dieu-khoan*", "/chinh-sach-bao-mat*"]
  }
}
